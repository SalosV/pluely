<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Microphone Access - for voice input -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Pluely needs access to your microphone for voice input functionality.</string>

  <!-- Screen Capture - for screenshot functionality -->
  <key>NSScreenCaptureUsageDescription</key>
  <string>Pluely needs access to screen capture for screenshot functionality.</string>

  <!-- System Audio - required for CoreAudio process taps to capture system audio -->
  <key>NSAudioCaptureUsageDescription</key>
  <string>Pluely needs access to system audio to transcribe meetings and process AI responses.</string>

  <!-- Privacy - Audio Processing -->
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryAudioProcessing</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>C617.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
